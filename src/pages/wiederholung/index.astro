---
import Base from '../../layouts/Base.astro';
import lektionenData from '../../data/lektionen.json';

const BASE = import.meta.env.BASE_URL;
---

<Base
  title="Falsche Fragen"
  description="Alle falsch beantworteten Quizfragen — gruppiert nach Lektion, mit Erklärung."
  breadcrumb={[{ label: 'Falsche Fragen' }]}
>
  <header class="seite-kopf">
    <div>
      <h1>🔁 Falsche Fragen wiederholen</h1>
      <p class="intro">
        Alle falsch beantworteten Quizfragen — mit deiner Antwort, der richtigen Lösung und Erklärung.
      </p>
    </div>
    <button class="btn btn-secondary" id="clear-fehler" type="button">Liste zurücksetzen</button>
  </header>

  <div id="wiederholung-liste" class="wiederholung-liste" data-lektionen={JSON.stringify(lektionenData)}>
    <p class="intro">Lade…</p>
  </div>
</Base>

<style>
  .seite-kopf {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 2rem;
    flex-wrap: wrap;
    margin-bottom: 1.5rem;
  }
  .seite-kopf h1 {
    font-size: clamp(1.7rem, 4vw, 2.3rem);
    letter-spacing: -0.02em;
    margin-bottom: 0.5rem;
  }
  .intro {
    color: var(--muted);
    max-width: 62ch;
  }
  .wiederholung-gruppe {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.25rem;
    margin-bottom: 1.25rem;
  }
  .wiederholung-gruppe h2 {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    font-size: 1.1rem;
    margin-bottom: 1rem;
    flex-wrap: wrap;
  }
  .wiederholung-frage {
    padding-bottom: 1.25rem;
    margin-bottom: 1.25rem;
    border-bottom: 1px solid var(--border);
  }
  .wiederholung-frage:last-child {
    border-bottom: none;
    margin-bottom: 0;
    padding-bottom: 0;
  }
  .frage {
    margin-bottom: 0.75rem;
  }
  .optionen {
    display: grid;
    gap: 0.5rem;
    margin-bottom: 0.75rem;
  }
  .option {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.6rem 0.85rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    font-size: 0.92rem;
  }
  .option.correct {
    border-color: var(--success);
    background: var(--success-soft);
  }
  .option.wrong {
    border-color: var(--danger);
    background: var(--danger-soft);
  }
  .option-buchstabe {
    flex-shrink: 0;
    display: grid;
    place-items: center;
    width: 1.4rem;
    height: 1.4rem;
    border-radius: 5px;
    background: var(--bg-subtle);
    border: 1px solid var(--border);
    font-size: 0.75rem;
    font-weight: 700;
  }
  .hinweis {
    margin-left: auto;
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.15rem 0.5rem;
    border-radius: 999px;
  }
  .hinweis.richtig {
    background: var(--success);
    color: #fff;
  }
  .hinweis.falsch {
    background: var(--danger);
    color: #fff;
  }
  .erklaerung {
    padding: 0.85rem 1rem;
    background: var(--bg-subtle);
    border-left: 3px solid var(--accent);
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
    font-size: 0.9rem;
  }
  .leer {
    text-align: center;
    padding: 3rem 1.5rem;
    background: var(--card);
    border: 1px dashed var(--border);
    border-radius: var(--radius);
  }
  .leer strong {
    display: block;
    font-size: 1.3rem;
    margin-bottom: 0.5rem;
  }
</style>

<script>
  import { escapeHtml } from '../../utils/escape';

  const liste = document.getElementById('wiederholung-liste') as HTMLElement;
  const BASE = import.meta.env.BASE_URL;

  function lade<T>(key: string, fallback: T): T {
    try { return JSON.parse(localStorage.getItem(key) || '') ?? fallback; } catch { return fallback; }
  }

  const fehler = lade<Record<string, Record<string, { richtig: boolean; selectedIdx: number; correctIdx: number }>>>('quiz-fehler', {});
  const alleLektionen: any[] = JSON.parse(liste.dataset.lektionen || '[]');

  const falscheFragen: Array<{
    slug: string;
    lektionTitel: string;
    frage: string;
    optionen: string[];
    richtigeAntwort: number;
    deineAntwort: number;
    erklaerung: string;
    level: number;
  }> = [];

  for (const [slug, fragen] of Object.entries(fehler)) {
    const lektion = alleLektionen.find((l: any) => l.slug === slug);
    if (!lektion) continue;
    for (const [frageIdx, ergebnis] of Object.entries(fragen)) {
      if (ergebnis.richtig) continue;
      const quizFrage = lektion.quiz?.[Number(frageIdx)];
      if (!quizFrage) continue;
      falscheFragen.push({
        slug,
        lektionTitel: lektion.title || slug,
        frage: quizFrage.frage,
        optionen: quizFrage.optionen || [],
        richtigeAntwort: quizFrage.antwort,
        deineAntwort: ergebnis.selectedIdx,
        erklaerung: quizFrage.erklaerung || '',
        level: lektion.level,
      });
    }
  }

  if (falscheFragen.length === 0) {
    liste.innerHTML = `
      <div class="leer">
        <strong>🎉 Keine falschen Fragen</strong>
        <p>Alles richtig beantwortet — oder noch keine Quizfragen bearbeitet.</p>
        <a class="btn" href="${BASE}quiz" style="margin-top: 1rem;">Zur Quiz-Zentrale</a>
      </div>
    `;
  } else {
    const gruppiert: Record<string, typeof falscheFragen> = {};
    for (const f of falscheFragen) {
      if (!gruppiert[f.slug]) gruppiert[f.slug] = [];
      gruppiert[f.slug].push(f);
    }

    liste.innerHTML = Object.entries(gruppiert)
      .map(([slug, fragen]) => {
        const level = fragen[0].level;
        return `
        <section class="wiederholung-gruppe">
          <h2>
            <a href="${BASE}lektionen/${escapeHtml(slug)}">${escapeHtml(fragen[0].lektionTitel)}</a>
            <span class="badge ${level === 1 ? 'badge-level-1' : 'badge-level-2'}">${escapeHtml(fragen.length)} falsch</span>
          </h2>
          ${fragen
            .map(f => {
              const optionen = f.optionen
                .map((opt, oi) => {
                  const istRichtig = oi === f.richtigeAntwort;
                  const istDeine = oi === f.deineAntwort;
                  const klasse = istRichtig ? 'correct' : istDeine ? 'wrong' : '';
                  return `
                  <div class="option ${klasse}">
                    <span class="option-buchstabe">${String.fromCharCode(65 + oi)}</span>
                    <span>${escapeHtml(opt)}</span>
                    ${istRichtig ? '<span class="hinweis richtig">✓ Richtig</span>' : ''}
                    ${istDeine && !istRichtig ? '<span class="hinweis falsch">✗ Deine Antwort</span>' : ''}
                  </div>`;
                })
                .join('');
              return `
              <div class="wiederholung-frage">
                <p class="frage"><strong>Frage:</strong> ${escapeHtml(f.frage)}</p>
                <div class="optionen">${optionen}</div>
                ${f.erklaerung ? `<p class="erklaerung"><strong>Erklärung:</strong> ${escapeHtml(f.erklaerung)}</p>` : ''}
              </div>`;
            })
            .join('')}
        </section>`;
      })
      .join('');
  }

  document.getElementById('clear-fehler')?.addEventListener('click', () => {
    localStorage.removeItem('quiz-fehler');
    location.reload();
  });
</script>
