---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const lektionen = await getCollection('lektionen');
const module = lektionen.map(l => ({
  nr: l.data.module,
  titel: l.data.title,
  slug: l.id,
  level: l.data.level,
}));

const level1 = module.filter(m => m.level === 1).sort((a, b) => a.nr - b.nr);
const level2 = module.filter(m => m.level === 2).sort((a, b) => a.nr - b.nr);
---

<Base title="Module">
  <h2>Alle Module</h2>
  
  <section>
    <h3>Level 1 — Helpdesk & Desktop Support</h3>
    <div class="grid grid-2">
      {level1.map(m => (
        <a href={`${import.meta.env.BASE_URL}lektionen/${m.slug}`} class="module-card">
          <span class="badge badge-level-1">Modul {m.nr}</span>
          <h4>{m.titel}</h4>
        </a>
      ))}
    </div>
  </section>

  <section>
    <h3>Level 2 — Systemadministration</h3>
    <div class="grid grid-2">
      {level2.map(m => (
        <a href={`${import.meta.env.BASE_URL}lektionen/${m.slug}`} class="module-card">
          <span class="badge badge-level-2">Modul {m.nr}</span>
          <h4>{m.titel}</h4>
        </a>
      ))}
    </div>
  </section>
</Base>

<style>
  h2 { margin-bottom: 1.5rem; }
  section { margin: 2rem 0; }
  section h3 {
    margin-bottom: 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 2px solid var(--accent);
  }
  .module-card {
    display: block;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 0.5rem;
    padding: 1rem;
  }
  .module-card:hover {
    text-decoration: none;
    box-shadow: var(--shadow);
  }
  .module-card h4 { margin-top: 0.5rem; }
</style>
