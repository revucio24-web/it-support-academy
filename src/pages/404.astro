---
import Base from '../layouts/Base.astro';
import lektionenData from '../data/lektionen.json';

const vorschlaege = [...lektionenData]
  .sort((a, b) => a.module - b.module)
  .slice(0, 6)
  .map(l => ({ slug: l.slug, titel: l.title ?? l.slug, modul: l.module ?? '' }));
const BASE = import.meta.env.BASE_URL;
const gesamt = lektionenData.length;
---

<Base
  title="Seite nicht gefunden"
  description="Diese Seite existiert nicht. Zurück zum IT-Support-Kurs."
  breadcrumb={[{ label: '404' }]}
>
  <section class="notfound">
    <p class="fehlercode" aria-hidden="true">404</p>
    <h1>Seite nicht gefunden</h1>
    <p class="intro">
      Diese Adresse gibt es nicht (mehr). Tippfehler in der URL? Nutze die Suche oder spring direkt zu einem Modul.
    </p>

    <input type="search" id="nf-suche" placeholder="Lektion suchen… (z. B. DNS, PowerShell, BitLocker)" autocomplete="off" aria-label="Lektion suchen" />
    <div id="nf-ergebnisse" class="grid grid-2" style="margin-top: 1rem;"></div>

    <h2>Häufige Einstiegspunkte</h2>
    <div class="grid grid-2">
      <a class="module-card" href={`${BASE}module`}>
        <strong>Alle {gesamt} Module</strong>
        <span>Level 1 &amp; 2 im Überblick</span>
      </a>
      <a class="module-card" href={`${BASE}fehler`}>
        <strong>Fehler &amp; Lösungen</strong>
        <span>Fehlerdatenbank durchsuchen</span>
      </a>
      <a class="module-card" href={`${BASE}quiz`}>
        <strong>Quiz</strong>
        <span>Wissen prüfen</span>
      </a>
      <a class="module-card" href={`${BASE}`}>
        <strong>Startseite</strong>
        <span>Zum Kursbeginn</span>
      </a>
    </div>

    <h2>Erste Lektionen</h2>
    <div class="grid grid-2">
      {vorschlaege.map(l => (
        <a class="module-card" href={`${BASE}lektionen/${l.slug}`}>
          <strong>{l.titel}</strong>
          <span>Modul {l.modul}</span>
        </a>
      ))}
    </div>
  </section>
</Base>

<style>
  .notfound .fehlercode {
    font-size: clamp(3rem, 10vw, 5rem);
    font-weight: 800;
    line-height: 1;
    background: linear-gradient(90deg, var(--accent), #9333ea);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    letter-spacing: -0.04em;
  }
  .notfound h1 {
    font-size: clamp(1.6rem, 4vw, 2.1rem);
    letter-spacing: -0.02em;
    margin-bottom: 0.75rem;
  }
  .notfound .intro {
    color: var(--muted);
    max-width: 60ch;
    margin-bottom: 1.25rem;
  }
  .notfound input[type="search"] {
    width: 100%;
    max-width: 32rem;
  }
  .notfound h2 {
    font-size: 1.2rem;
    margin: 2.25rem 0 1rem;
  }
  .module-card {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.1rem 1.25rem;
    color: var(--fg);
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }
  .module-card:hover {
    border-color: var(--accent);
    box-shadow: var(--shadow-sm);
    text-decoration: none;
  }
  .module-card span {
    font-size: 0.85rem;
    color: var(--muted);
  }
</style>

<script>
  import lektionenData from '../data/lektionen.json';
  import { escapeHtml } from '../utils/escape';

  const eingabe = document.getElementById('nf-suche') as HTMLInputElement;
  const ausgabe = document.getElementById('nf-ergebnisse') as HTMLElement;
  const BASE = import.meta.env.BASE_URL;

  const alle = lektionenData.map(l => ({
    slug: l.slug,
    titel: l.title || l.slug,
    modul: String(l.module ?? ''),
    level: String(l.level ?? ''),
    text: [
      l.title || '',
      String(l.module ?? ''),
      (l.schwerpunkt || []).join(' '),
      ...(l.fehler || []).map(f => `${f.titel || ''} ${f.symptom || ''} ${f.ursache || ''}`),
      ...(l.quiz || []).map(q => q.frage || ''),
    ].join(' ').toLowerCase(),
  }));

  function rendern(treffer: typeof alle) {
    if (treffer.length === 0) {
      ausgabe.innerHTML = '<p class="intro">Keine Lektion gefunden — nutze die Modul-Übersicht.</p>';
      return;
    }
    ausgabe.innerHTML = treffer
      .slice(0, 10)
      .map(
        l =>
          `<a class="module-card" href="${BASE}lektionen/${escapeHtml(l.slug)}">
             <strong>${escapeHtml(l.titel)}</strong>
             <span>Modul ${escapeHtml(l.modul)} · Level ${escapeHtml(l.level)}</span>
           </a>`
      )
      .join('');
  }

  eingabe?.addEventListener('input', () => {
    const q = eingabe.value.trim().toLowerCase();
    if (q.length < 2) {
      ausgabe.innerHTML = '';
      return;
    }
    rendern(alle.filter(l => l.text.includes(q)));
  });
</script>
