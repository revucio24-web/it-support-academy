---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import FehlerKarte from '../../components/FehlerKarte.astro';
import Quiz from '../../components/Quiz.astro';
import TicketSzenario from '../../components/TicketSzenario.astro';
import lektionenData from '../../data/lektionen.json';

export async function getStaticPaths() {
  const lektionen = await getCollection('lektionen');
  return lektionen.map(l => ({
    params: { slug: l.id },
    props: { lektion: l },
  }));
}

const { lektion } = Astro.props;
const { title, level, module, last_verified, windows_version, sources } = lektion.data;

const alleLektionen = await getCollection('lektionen');
const aktuellePosition = alleLektionen.findIndex(l => l.id === lektion.id);
const prev = aktuellePosition > 0 ? alleLektionen[aktuellePosition - 1] : null;
const next = aktuellePosition < alleLektionen.length - 1 ? alleLektionen[aktuellePosition + 1] : null;

// Strukturierte Daten aus JSON
const data = lektionenData.find(l => l.slug === lektion.id);
const fehler = data?.fehler || [];
const quiz = data?.quiz || [];
const ticket = data?.ticket || [];
---

<Base title={title}>
  <article class="lektion">
    <header class="lektion-header">
      <div class="lektion-meta">
        <span class={level === 1 ? 'badge badge-level-1' : 'badge badge-level-2'}>
          Level {level}
        </span>
        <span class="badge">Modul {module}</span>
      </div>
      <h2>{title}</h2>
      <div class="lektion-info">
        <span>Zuletzt geprüft: {last_verified}</span>
        <span>{windows_version}</span>
      </div>
    </header>

    <div class="lektion-content">
      <slot />

      {fehler.length > 0 && (
        <section class="fehler-section">
          <h3>⚠️ Typische Fehler & Lösungen</h3>
          <div class="fehler-liste">
            {fehler.map((f, i) => (
              <FehlerKarte
                titel={f.titel}
                symptomatik={f.symptom}
                ursache={f.ursache}
                diagnose={f.diagnose_schritte || f.diagnose || []}
                loesung={f.loesung}
                praevention={f.praevention}
                modul={module}
              />
            ))}
          </div>
        </section>
      )}

      {quiz.length > 0 && (
        <section class="quiz-section">
          <Quiz questions={quiz} />
        </section>
      )}

      {ticket.length > 0 && ticket.map((t, i) => (
        <section class="ticket-section">
          <TicketSzenario
            situation={t.situation}
            aufgabe={t.aufgabe}
            loesung={t.loesung}
          />
        </section>
      ))}

      <section class="quellen">
        <h3>Quellen</h3>
        <ul>
          {sources.map(s => (
            <li>
              <a href={s.url} target="_blank" rel="noopener noreferrer">{s.url}</a>
              <span> — abgerufen am {s.abrufdatum}</span>
            </li>
          ))}
        </ul>
      </section>
    </div>

    <footer class="lektion-footer">
      <button class="btn" onclick="markComplete('{lektion.id}')">
        ✅ Als abgeschlossen markieren
      </button>
    </footer>
  </article>
</Base>

<style>
  .lektion-header {
    margin-bottom: 2rem;
    padding-bottom: 1rem;
    border-bottom: 2px solid var(--accent);
  }
  .lektion-meta {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 0.75rem;
  }
  .lektion-info {
    display: flex;
    gap: 1rem;
    color: var(--muted);
    font-size: 0.875rem;
    margin-top: 0.5rem;
  }
  .lektion-content {
    max-width: 800px;
  }
  .quellen {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
  }
  .quellen h3 {
    margin-bottom: 0.75rem;
  }
  .quellen ul {
    list-style: none;
    padding: 0;
  }
  .quellen li {
    margin-bottom: 0.5rem;
    font-size: 0.875rem;
    color: var(--muted);
  }
  .lektion-footer {
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
  }
</style>

<script>
  function markComplete(slug: string) {
    const progress = JSON.parse(localStorage.getItem('kurs-fortschritt') || '{}');
    progress[slug] = true;
    localStorage.setItem('kurs-fortschritt', JSON.stringify(progress));
    window.location.reload();
  }

  // Check if already completed
  const progress = JSON.parse(localStorage.getItem('kurs-fortschritt') || '{}');
  if (progress['{lektion.id}']) {
    document.querySelector('.lektion-footer .btn')!.textContent = '✅ Bereits abgeschlossen';
    document.querySelector('.lektion-footer .btn')!.disabled = true;
  }
</script>
