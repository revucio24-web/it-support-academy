---
import Base from '../../layouts/Base.astro';
import FehlerKarte from '../../components/FehlerKarte.astro';
import lektionenData from '../../data/lektionen.json';

// Alle Fehlerkarten werden gerendert (versteckt) — der Client zeigt nur die
// mit Stern. So bleibt die Karte genau wie auf der Lektionsseite.
const alleFehler = lektionenData.flatMap(l =>
  (l.fehler || []).map(f => ({ slug: l.slug, modul: l.module, level: l.level, ...f }))
);
---

<Base
  title="Lesezeichen"
  description="Deine gespeicherten Fehlerkarten — schnell wiederfinden und weiterlernen."
  breadcrumb={[{ label: 'Lesezeichen' }]}
>
  <header class="seite-kopf">
    <div>
      <h1>🔖 Meine Lesezeichen</h1>
      <p class="intro">Gespeicherte Fehlerkarten — auf jeder Lektionsseite per ⭐ hinzufügbar.</p>
    </div>
    <span class="zaehler" id="lesezeichen-zaehler">0 gespeichert</span>
  </header>

  <div id="lesezeichen-liste" class="lesezeichen-liste">
    {alleFehler.map(f => (
      <FehlerKarte
        titel={f.titel}
        symptomatik={f.symptom}
        ursache={f.ursache}
        diagnose={f.diagnose_schritte || []}
        loesung={f.loesung}
        praevention={f.praevention}
        modul={f.modul}
        level={f.level}
        slug={f.slug}
      />
    ))}
    <p id="leer-hinweis" class="leer" hidden>
      <strong>Noch keine Lesezeichen</strong>
      Öffne eine Lektion und klicke auf ⭐ an einer Fehlerkarte.
    </p>
    <a class="btn btn-secondary" href={`${import.meta.env.BASE_URL}fehler`} style="justify-self: start;">Fehlerkarten entdecken →</a>
  </div>
</Base>

<style>
  .seite-kopf {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 2rem;
    flex-wrap: wrap;
    margin-bottom: 1.5rem;
  }
  .seite-kopf h1 {
    font-size: clamp(1.7rem, 4vw, 2.3rem);
    letter-spacing: -0.02em;
    margin-bottom: 0.5rem;
  }
  .intro {
    color: var(--muted);
    max-width: 62ch;
  }
  .zaehler {
    background: var(--accent-soft);
    color: var(--accent);
    font-weight: 700;
    padding: 0.6rem 1.1rem;
    border-radius: 999px;
    font-size: 0.9rem;
    white-space: nowrap;
  }
  .lesezeichen-liste {
    display: grid;
    gap: 1rem;
  }
  .lesezeichen-liste .fehler-karte {
    display: none;
  }
  .lesezeichen-liste .fehler-karte.sichtbar {
    display: block;
  }
  .leer {
    text-align: center;
    padding: 3rem 1.5rem;
    background: var(--card);
    border: 1px dashed var(--border);
    border-radius: var(--radius);
  }
  .leer strong {
    display: block;
    font-size: 1.25rem;
    margin-bottom: 0.5rem;
  }
</style>

<script>
  const liste = document.getElementById('lesezeichen-liste')!;
  const zaehler = document.getElementById('lesezeichen-zaehler')!;

  function lesezeichen(): string[] {
    try { return JSON.parse(localStorage.getItem('kurs-lesezeichen') || '[]'); } catch { return []; }
  }

  function anzeigen() {
    const saved = lesezeichen();
    let sichtbar = 0;
    liste.querySelectorAll<HTMLElement>('.fehler-karte').forEach(karte => {
      const id = karte.dataset.bookmarkId || '';
      const zeigen = saved.includes(id);
      karte.classList.toggle('sichtbar', zeigen);
      if (zeigen) sichtbar++;
    });
    zaehler.textContent = `${sichtbar} gespeichert`;
    const hinweis = document.getElementById('leer-hinweis');
    if (hinweis) hinweis.hidden = sichtbar > 0;
  }

  // Reagiere auf Änderungen von anderen Seiten/Tabs
  window.addEventListener('storage', anzeigen);
  anzeigen();
</script>
