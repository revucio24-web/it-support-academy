---
import Base from '../../layouts/Base.astro';
import lektionenData from '../../data/lektionen.json';

const total = lektionenData.length;
---

<Base
  title="Zertifikat"
  description="Kursabschluss-Zertifikat — wird freigeschaltet, sobald alle Module abgeschlossen sind."
  breadcrumb={[{ label: 'Zertifikat' }]}
>
  <header class="seite-kopf">
    <div>
      <h1>🎓 Kursabschluss-Zertifikat</h1>
      <p class="intro">IT-Support-Kurs — Level 1 &amp; 2 · {total} Module</p>
    </div>
  </header>

  <div id="zertifikat-status" class="zertifikat-status">
    <p class="intro">Prüfe Fortschritt…</p>
  </div>

  <div id="zertifikat-inhalt" class="zertifikat-inhalt" hidden>
    <div class="zertifikat-kopf">
      <span class="zertifikat-emoji" aria-hidden="true">🎓</span>
      <h2>IT-Support-Kurs</h2>
      <p class="zertifikat-titel">Level 1 &amp; 2 — Deutschsprachiger Kurs für den IT-Support</p>
    </div>

    <div class="zertifikat-daten">
      <div class="zertifikat-zeile">
        <span>Absolvent</span>
        <strong id="zertifikat-name">—</strong>
      </div>
      <div class="zertifikat-zeile">
        <span>Datum</span>
        <strong id="zertifikat-datum">—</strong>
      </div>
      <div class="zertifikat-zeile">
        <span>Module abgeschlossen</span>
        <strong id="zertifikat-module">—</strong>
      </div>
      <div class="zertifikat-zeile">
        <span>Quiz-Ergebnis</span>
        <strong id="zertifikat-quiz">—</strong>
      </div>
      <div class="zertifikat-zeile">
        <span>Fehlerkarten gespeichert</span>
        <strong id="zertifikat-lesezeichen">—</strong>
      </div>
    </div>

    <div class="zertifikat-fuss">
      <p>
        Bestätigt den Abschluss des IT-Support-Kurses mit Homelab-Praxis, Fehleranalyse und Ticket-Simulation.
      </p>
      <p class="zertifikat-id" id="zertifikat-id">—</p>
      <button class="btn" onclick="window.print()" type="button">🖨️ Drucken / als PDF speichern</button>
    </div>
  </div>
</Base>

<style>
  .seite-kopf {
    margin-bottom: 1.5rem;
  }
  .seite-kopf h1 {
    font-size: clamp(1.7rem, 4vw, 2.3rem);
    letter-spacing: -0.02em;
    margin-bottom: 0.5rem;
  }
  .intro {
    color: var(--muted);
  }
  .fortschritt-hinweis {
    max-width: 640px;
    margin: 0 auto;
    text-align: center;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 2rem;
  }
  .fortschritt-hinweis p {
    margin-bottom: 0.75rem;
  }
  .fortschritt-hinweis .balken {
    height: 8px;
    background: var(--border);
    border-radius: 999px;
    overflow: hidden;
    margin: 1rem 0;
  }
  .fortschritt-hinweis .balken > div {
    height: 100%;
    background: linear-gradient(90deg, var(--accent), #9333ea);
    border-radius: 999px;
  }

  .zertifikat-inhalt {
    max-width: 760px;
    margin: 0 auto;
    background: #ffffff;
    color: #0f172a;
    border: 3px solid var(--accent);
    border-radius: 1rem;
    padding: 2.5rem;
  }
  .zertifikat-kopf {
    text-align: center;
    padding-bottom: 1.75rem;
    border-bottom: 2px solid #e2e8f0;
    margin-bottom: 1.75rem;
  }
  .zertifikat-emoji {
    font-size: 2.2rem;
    display: block;
    margin-bottom: 0.5rem;
  }
  .zertifikat-kopf h2 {
    font-size: 1.8rem;
    letter-spacing: -0.02em;
    margin-bottom: 0.35rem;
  }
  .zertifikat-titel {
    color: #64748b;
    font-size: 0.95rem;
  }
  .zertifikat-daten {
    margin-bottom: 1.75rem;
  }
  .zertifikat-zeile {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.8rem 0;
    border-bottom: 1px solid #f1f5f9;
  }
  .zertifikat-zeile span {
    color: #64748b;
    font-size: 0.9rem;
  }
  .zertifikat-fuss {
    text-align: center;
    padding-top: 1.5rem;
    border-top: 2px solid #e2e8f0;
    color: #64748b;
    font-size: 0.85rem;
  }
  .zertifikat-id {
    margin: 0.75rem 0 1.25rem;
    font-family: var(--mono, monospace);
    color: #94a3b8;
    font-size: 0.8rem;
  }

  @media print {
    header, footer, .progress-container, .seite-kopf, .btn, .skip-link {
      display: none !important;
    }
    main {
      padding: 0;
    }
    .zertifikat-inhalt {
      border: 2px solid #000;
      border-radius: 0;
      padding: 1.5rem;
    }
  }
</style>

<script define:vars={{ total }}>
  const statusEl = document.getElementById('zertifikat-status');
  const inhaltEl = document.getElementById('zertifikat-inhalt');

  function lade<T>(key: string, fallback: T): T {
    try { return JSON.parse(localStorage.getItem(key) || '') ?? fallback; } catch (e) { return fallback; }
  }

  const progress = lade<Record<string, boolean>>('kurs-fortschritt', {});
  const quizErgebnisse = lade<Record<string, { richtig: number; gesamt: number }>>('quiz-ergebnisse', {});
  const lesezeichen = lade<string[]>('kurs-lesezeichen', []);

  const done = Object.keys(progress).filter(k => progress[k] === true).length;
  const pct = total > 0 ? Math.round((done / total) * 100) : 0;

  if (pct < 100) {
    statusEl.innerHTML = `
      <div class="fortschritt-hinweis">
        <p><strong>⚠️ Noch nicht alle Lektionen abgeschlossen.</strong></p>
        <p><strong>${done}/${total}</strong> Module fertig (${pct} %).</p>
        <div class="balken"><div style="width: ${pct}%"></div></div>
        <p>Markiere alle Module als abgeschlossen, um dein Zertifikat zu aktivieren.</p>
        <a class="btn" href="${import.meta.env.BASE_URL}module">Weiterlernen</a>
      </div>
    `;
  } else {
    statusEl.hidden = true;
    inhaltEl.hidden = false;

    document.getElementById('zertifikat-name')!.textContent =
      localStorage.getItem('kurs-name') || 'IT-Support-Kursabsolvent';
    document.getElementById('zertifikat-datum')!.textContent = new Date().toLocaleDateString('de-DE', {
      year: 'numeric',
      month: 'long',
      day: 'numeric',
    });
    document.getElementById('zertifikat-module')!.textContent = `${done}/${total}`;

    const quizKeys = Object.keys(quizErgebnisse);
    const quizRichtig = quizKeys.reduce((s, k) => s + quizErgebnisse[k].richtig, 0);
    const quizGesamt = quizKeys.reduce((s, k) => s + quizErgebnisse[k].gesamt, 0);
    const quizPct = quizGesamt > 0 ? Math.round((quizRichtig / quizGesamt) * 100) : 0;
    document.getElementById('zertifikat-quiz')!.textContent = `${quizRichtig}/${quizGesamt} (${quizPct} %)`;

    document.getElementById('zertifikat-lesezeichen')!.textContent = String(lesezeichen.length);

    const id =
      'IT-SUPPORT-' + Date.now().toString(36).toUpperCase() + '-' + Math.random().toString(36).slice(2, 8).toUpperCase();
    document.getElementById('zertifikat-id')!.textContent = 'Zertifikat-ID: ' + id;
  }
</script>
