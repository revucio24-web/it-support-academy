---
interface Props {
  titel: string;
  symptomatik: string;
  ursache: string;
  diagnose: string[];
  loesung: string;
  praevention: string;
  modul?: number;
}

const { titel, symptomatik, ursache, diagnose, loesung, praevention, modul, slug } = Astro.props;

const bookmarkId = `fehler-${slug}-${titel.toLowerCase().replace(/\s+/g, '-').slice(0, 30)}`;
---

<div class="fehler-karte" data-modul={modul} data-bookmark-id={bookmarkId}>
  <div class="fehler-header">
    <h4>⚠️ {titel}</h4>
    <div class="fehler-header-actions">
      {modul && <span class="badge badge-level-2">Modul {modul}</span>}
      <button class="bookmark-btn" data-bookmark={bookmarkId} title="Lesezeichen hinzufügen">
        ☆
      </button>
    </div>
  </div>
  <div class="fehler-body">
    <div class="fehler-abschnitt">
      <h5>Symptomatik</h5>
      <p>{symptomatik}</p>
    </div>
    <div class="fehler-abschnitt">
      <h5>Ursache</h5>
      <p>{ursache}</p>
    </div>
    <div class="fehler-abschnitt">
      <h5>Diagnose-Schritte</h5>
      <ol>
        {diagnose.map(schritt => <li>{schritt}</li>)}
      </ol>
    </div>
    <div class="fehler-abschnitt">
      <h5>Lösung</h5>
      <p>{loesung}</p>
    </div>
    <div class="fehler-abschnitt">
      <h5>Prävention</h5>
      <p>{praevention}</p>
    </div>
  </div>
</div>

<style>
  .fehler-karte {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 0.5rem;
    margin-bottom: 1rem;
    overflow: hidden;
  }
  .fehler-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1rem 1.5rem;
    background: var(--bg);
    border-bottom: 1px solid var(--border);
  }
  .fehler-header h4 {
    font-size: 1rem;
  }
  .fehler-header-actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .bookmark-btn {
    background: none;
    border: 1px solid var(--border);
    border-radius: 0.375rem;
    padding: 0.25rem 0.5rem;
    cursor: pointer;
    font-size: 1rem;
    color: var(--muted);
    transition: all 0.2s;
  }
  .bookmark-btn:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
  .bookmark-btn.active {
    background: var(--accent);
    color: white;
    border-color: var(--accent);
  }
  .fehler-body {
    padding: 1.5rem;
  }
  .fehler-abschnitt {
    margin-bottom: 1rem;
  }
  .fehler-abschnitt:last-child {
    margin-bottom: 0;
  }
  .fehler-abschnitt h5 {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--muted);
    margin-bottom: 0.25rem;
  }
  .fehler-abschnitt ol {
    padding-left: 1.25rem;
  }
  .fehler-abschnitt li {
    margin-bottom: 0.25rem;
  }
</style>
