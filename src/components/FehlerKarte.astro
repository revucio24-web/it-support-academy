---
interface Props {
  titel: string;
  symptomatik: string;
  ursache: string;
  diagnose: string[];
  loesung: string;
  praevention: string;
  modul?: number;
  slug?: string;
  level?: number;
}

const { titel, symptomatik, ursache, diagnose, loesung, praevention, modul, slug = '', level = 1 } = Astro.props;

// Stabile ID: inhaltsbasiert, nicht indexbasiert — übersteht Umsortierungen.
const bookmarkId = `fehler-${slug}-${titel.toLowerCase().replace(/[^\wäöüß]+/g, '-').replace(/^-|-$/g, '').slice(0, 40)}`;
---

<article class="fehler-karte" data-bookmark-id={bookmarkId}>
  <header class="fehler-kopf">
    <div class="fehler-kopf-titel">
      <span class="fehler-symbol" aria-hidden="true">⚠️</span>
      <h4>{titel}</h4>
    </div>
    <div class="fehler-kopf-aktionen">
      {modul !== undefined && <span class={level === 1 ? 'badge badge-level-1' : 'badge badge-level-2'}>Modul {modul}</span>}
      <button class="bookmark-btn" data-bookmark={bookmarkId} aria-pressed="false" title="Lesezeichen hinzufügen">☆</button>
    </div>
  </header>

  <div class="fehler-grid">
    <section class="fehler-block">
      <h5>Symptomatik</h5>
      <p>{symptomatik}</p>
    </section>
    <section class="fehler-block">
      <h5>Ursache</h5>
      <p>{ursache}</p>
    </section>
    <section class="fehler-block">
      <h5>Diagnose-Schritte</h5>
      <ol>
        {diagnose.map(schritt => <li>{schritt}</li>)}
      </ol>
    </section>
    <section class="fehler-block">
      <h5>Lösung</h5>
      <div class="loesung-text">
        {loesung.split('\n').filter(l => l.trim()).map(zeile => <p>{zeile.replace(/^[-*]\s*/, '')}</p>)}
      </div>
    </section>
    <section class="fehler-block">
      <h5>Prävention</h5>
      <p>{praevention}</p>
    </section>
  </div>
</article>

<style>
  .fehler-karte {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
    transition: box-shadow 0.2s ease, border-color 0.2s ease;
  }
  .fehler-karte:hover {
    box-shadow: var(--shadow-md);
    border-color: var(--accent);
  }
  .fehler-kopf {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem 1.25rem;
    background: var(--bg-subtle);
    border-bottom: 1px solid var(--border);
  }
  .fehler-kopf-titel {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    min-width: 0;
  }
  .fehler-symbol {
    flex-shrink: 0;
    line-height: 1.4;
  }
  .fehler-kopf h4 {
    font-size: 1rem;
    font-weight: 700;
  }
  .fehler-kopf-aktionen {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-shrink: 0;
  }
  .bookmark-btn {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--bg);
    cursor: pointer;
    font-size: 1rem;
    line-height: 1;
    color: var(--muted);
    transition: all 0.15s ease;
  }
  .bookmark-btn:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
  .bookmark-btn.active {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--accent-fg);
  }
  .fehler-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
    gap: 1.25rem;
    padding: 1.25rem;
  }
  .fehler-block h5 {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: var(--muted);
    margin-bottom: 0.4rem;
    font-weight: 700;
  }
  .fehler-block p {
    font-size: 0.92rem;
  }
  .fehler-block ol {
    padding-left: 1.15rem;
    font-size: 0.92rem;
    display: grid;
    gap: 0.25rem;
  }
  .loesung-text p + p {
    margin-top: 0.35rem;
  }
</style>
