---
interface Props {
  situation: string;
  aufgabe: string;
  loesung?: string;
  kategorie?: string;
}

const { situation, aufgabe, loesung = '', kategorie = 'Praxis' } = Astro.props;
---

<details class="ticket-szenario">
  <summary>
    <span class="ticket-label">🎫 Ticket-Szenario</span>
    <span class="badge">{kategorie}</span>
  </summary>
  <div class="ticket-content">
    <section class="ticket-bereich">
      <h4>Situation</h4>
      <p>{situation}</p>
    </section>
    <section class="ticket-bereich">
      <h4>Aufgabe</h4>
      <div class="aufgabe-text">
        {aufgabe.split('\n').filter(l => l.trim()).map(zeile => <p>{zeile}</p>)}
      </div>
    </section>
    <section class="ticket-bereich">
      <h4>Lösung</h4>
      <div class="loesung-content">
        {loesung.split('\n').filter(l => l.trim()).map(zeile => <p>{zeile}</p>)}
      </div>
    </section>
  </div>
</details>

<style>
  .ticket-szenario {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
    margin: 1.5rem 0;
  }
  .ticket-szenario summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem 1.25rem;
    cursor: pointer;
    list-style: none;
    font-weight: 600;
    background: var(--bg-subtle);
    border-bottom: 1px solid transparent;
    transition: background 0.15s ease;
  }
  .ticket-szenario summary::-webkit-details-marker {
    display: none;
  }
  .ticket-szenario summary:hover {
    background: var(--accent-soft);
  }
  .ticket-szenario[open] summary {
    border-bottom-color: var(--border);
  }
  .ticket-label {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .ticket-content {
    padding: 1.25rem;
    display: grid;
    gap: 1.25rem;
  }
  .ticket-bereich h4 {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: var(--muted);
    margin-bottom: 0.5rem;
    font-weight: 700;
  }
  .aufgabe-text p,
  .loesung-content p {
    margin-bottom: 0.4rem;
    font-size: 0.92rem;
  }
  .aufgabe-text p:last-child,
  .loesung-content p:last-child {
    margin-bottom: 0;
  }
  .loesung-content {
    background: var(--success-soft);
    border-left: 3px solid var(--success);
    border-radius: var(--radius-sm);
    padding: 1rem 1.1rem;
  }
</style>
